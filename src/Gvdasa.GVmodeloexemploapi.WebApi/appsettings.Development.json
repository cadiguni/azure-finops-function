{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Storage.IRelationalCommandBuilderFactory": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Desativado_Em_Maquina_De_Desenvolvimento_Apenas_Log_Em_Console"
      }
    ]
  },
  "Report": {
    "Url": "https://jsreport-dev-wa.azurewebsites.net/"
  }
}
